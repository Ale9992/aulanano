# Copia questo file in server/.env e personalizzalo. server/.env non va pubblicato.
# Cartella per Chrome estratto, profilo e modello (servono ~25 GB liberi). Predefinita: ../data
GN_BASE=/percorso/con/spazio/aulanano-data
# Porta HTTP del bridge (ascolta solo su 127.0.0.1)
GN_PORT=8787
# Come viene descritto il server nell'interfaccia
GN_LABEL=un server della tua rete
